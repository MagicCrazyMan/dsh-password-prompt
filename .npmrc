# The @deepseek-ai peer packages are provided by the host DSH profile at
# runtime, never by the registry during this package's own install. pnpm
# prepares git-hosted dependencies by running `npm install` in this dir,
# and npm would otherwise try to resolve the whole @deepseek-ai peer graph
# (whose rc-version cross-peer constraints conflict). Skip that resolution:
# the peers are guaranteed by the DSH installation, not by npm.
legacy-peer-deps=true
